{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "quality:site": "start-server-and-test \"pnpm run start\" http://127.0.0.1:3000 \"PW_NO_WEBSERVER=1 pnpm run quality:site:inner\"",
    "quality:site:inner": "lhci autorun --config=./lighthouserc.cjs && playwright test && pa11y-ci --config ./pa11y-ci.json"
  },
  "dependencies": {
    "@fcw/auth-policy": "workspace:*",
    "@fcw/ui": "workspace:*",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^1.9.4",
    "@fcw/tsconfig": "workspace:*",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.0.0",
    "msw": "^2.14.6",
    "pa11y-ci": "^4.1.1",
    "postcss": "^8.5.3",
    "start-server-and-test": "^3.0.5",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.7.2",
    "vitest": "^3.1.2",
    "vitest-axe": "^0.1.0"
  }
}
